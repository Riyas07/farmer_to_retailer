# Copy to .env for local development. Nothing here needs to be real to run Foundation phase —
# every external provider is mocked (docs/architecture.md §5).

NODE_ENV=development
PORT=3000

# Postgres — a local/dev Postgres instance. See docs/erd.md for the schema this backs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_to_retailer?schema=public

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Business config — admin-configurable per docs/order-state-machine.md, env var is just the V1 default.
PAYOUT_HOLD_WINDOW_HOURS=48

# Mock payment gateway tuning (apps/api/src/providers/mock/mock-payment-gateway.provider.ts) — lets the
# hold -> release -> settle sequence and the hold-ceiling cutoff be exercised in dev/tests without a real
# gateway account. See docs/decisions/provider-capabilities-payment-split.md.
MOCK_PAYMENT_SETTLEMENT_LAG_MS=3000
MOCK_PAYMENT_HOLD_CEILING_DAYS=45
MOCK_PAYMENT_LINKED_ACCOUNT_ACTIVATION_DELAY_MS=0

# S3 (real adapter — apps/api/src/providers/storage/s3-storage.provider.ts — but nothing calls it yet in
# Foundation phase, so these can stay blank until the Marketplace phase adds image upload).
AWS_REGION=
AWS_S3_BUCKET=
