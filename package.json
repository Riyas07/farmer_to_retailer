{
  "name": "farmer-to-retailer",
  "version": "0.0.0",
  "private": true,
  "description": "B2B agricultural marketplace connecting farmers and retailers across India \u2014 monorepo root.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "lint": "pnpm -r --filter=./packages/* --filter=./apps/* run lint",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* run typecheck",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/* run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
